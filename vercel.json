{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "movie",
          "value": "(?<movieId>[0-9]+)"
        }
      ],
      "destination": "/m/:movieId",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/m/:id",
      "destination": "/api/og?movie=:id"
    },
    {
      "source": "/movie/:id",
      "destination": "/api/og?movie=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
