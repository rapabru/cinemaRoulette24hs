{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "movie"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/m/:id",
      "destination": "/api/og?movie=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
